---
import { siteConfig } from '@data/siteConfig';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-content">
    <p class="copyright">
      <span class="accent-prompt">~</span> © {year} {siteConfig.author}. Construido desde {siteConfig.location}.
    </p>
    
    <div class="social-links">
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <span class="separator">/</span>
      <a href={`mailto:${siteConfig.social.email}`}>Email</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-color);
    padding: 2rem 0;
    margin-top: 4rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .accent-prompt {
    color: var(--accent);
  }

  .social-links {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .social-links a {
    font-size: 0.9rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--accent);
  }

  .separator {
    color: var(--border-color);
    font-family: var(--font-mono);
  }

  @media (max-width: 600px) {
    .footer {
      margin-top: 3rem;
      padding: 1.5rem 0;
    }

    .footer-content {
      flex-direction: column;
      text-align: center;
      gap: 0.85rem;
    }
  }
</style>
