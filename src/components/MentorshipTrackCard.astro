---
import type { MentorshipTrack } from '@types/portfolio';

interface Props {
  track: MentorshipTrack;
}

const { track } = Astro.props;
const firstLessonUrl = track.lessons.length > 0 ? track.lessons[0].url : '#';
---

<article class="track-card">
  <!-- Cabecera estilo prompt / ruta de sistema -->
  <div class="track-meta-bar">
    <div class="track-path">
      <span class="path-prefix">dir:</span> ~/mentorias/{track.folderSlug}/
    </div>
    <div class="track-status">
      <span class="status-dot"></span>
      <span class="status-count">{track.totalLessons} {track.totalLessons === 1 ? 'CLASE' : 'CLASES'}</span>
    </div>
  </div>

  <!-- Título e icono -->
  <div class="track-heading">
    <span class="track-icon" aria-hidden="true">{track.icon}</span>
    <h3 class="track-title">{track.title}</h3>
  </div>

  <p class="track-desc">{track.description}</p>

  <!-- Etiquetas tecnológicas -->
  {track.tags.length > 0 && (
    <div class="tags">
      {track.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}

  <!-- Bloque terminal del plan de estudios (Syllabus) -->
  <div class="syllabus-box">
    <div class="syllabus-header">
      <span class="prompt-symbol">$</span>
      <span class="syllabus-cmd">tree -L 1 --sort=name</span>
    </div>

    <ul class="lesson-list">
      {track.lessons.map((lesson) => (
        <li class="lesson-item">
          <a href={lesson.url} class="lesson-link">
            <span class="lesson-num">[{String(lesson.order).padStart(2, '0')}]</span>
            <span class="lesson-name">{lesson.title}</span>
            <span class="lesson-action">&gt;_ Leer</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Footer de la tarjeta con acción rápida -->
  <div class="track-footer">
    <div class="track-level">
      <span class="level-badge">{track.level}</span>
    </div>

    {track.lessons.length > 0 && (
      <a href={firstLessonUrl} class="btn-start">
        &gt;_ Iniciar módulo
      </a>
    )}
  </div>
</article>

<style>
  .track-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .track-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 10px 30px -15px var(--accent-glow);
  }

  /* Barra superior de terminal */
  .track-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding-bottom: 0.85rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .track-path {
    color: var(--text-muted);
  }

  .path-prefix {
    color: var(--accent);
    font-weight: 700;
  }

  .track-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background-color: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    color: #22c55e;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background-color: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 6px #22c55e;
  }

  /* Encabezado */
  .track-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .track-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .track-title {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--text-main);
    line-height: 1.3;
  }

  .track-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-main);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  /* Bloque Syllabus */
  .syllabus-box {
    background-color: var(--bg-code, #070a12);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 0.9rem 1rem;
    margin-bottom: 1.5rem;
  }

  .syllabus-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .prompt-symbol {
    color: var(--accent);
    font-weight: 700;
  }

  .syllabus-cmd {
    color: var(--text-muted);
  }

  .lesson-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .lesson-item {
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .lesson-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.5rem;
    text-decoration: none;
    color: var(--text-main);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .lesson-link:hover {
    background-color: rgba(56, 189, 248, 0.08);
    color: var(--accent);
    transform: translateX(3px);
  }

  .lesson-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }

  .lesson-name {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lesson-action {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    white-space: nowrap;
    opacity: 0.85;
  }

  /* Footer */
  .track-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .level-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .btn-start {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .btn-start:hover {
    color: var(--accent-hover);
    transform: translateX(3px);
  }
</style>
