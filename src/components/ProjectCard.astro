---
// Aquí definimos las variables que recibirá la tarjeta
const { title, description, tags, repoLink } = Astro.props;
---

<article class="card">
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  
  <div class="tags">
    {tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>

  <div class="card-links">
    <a href={repoLink} target="_blank" class="link-repo">
      >_ Ver código
    </a>
  </div>
</article>

<style>
  .card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
  }

  .card-title {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    color: var(--text-main);
    margin-bottom: 0.8rem;
  }

  .card-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    flex-grow: 1; /* Empuja los enlaces hacia abajo */
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--accent);
    background-color: rgba(56, 189, 248, 0.1); /* Azul muy transparente */
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .link-repo {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
