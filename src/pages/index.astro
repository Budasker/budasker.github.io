---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// 1. Datos estructurados de Habilidades (fácil de escalar)
const skillCategories = [
  {
    title: "🐧 Sistemas y Seguridad",
    skills: ["Linux / EndeavourOS", "Bash Scripting", "Hardening Básico", "OverTheWire / Wargames"]
  },
  {
    title: "🌐 Redes e Infraestructura",
    skills: ["OpenWrt", "SQM & QoS", "Análisis de Tráfico", "DNS / Ad-blocking"]
  },
  {
    title: "💻 Desarrollo y Herramientas",
    skills: ["C++", "Git & GitHub", "Geany / Editores CLI", "Automatización"]
  },
  {
    title: "📱 Hardware y Bajo Nivel",
    skills: ["Custom ROMs (Android)", "Flashing / ADB", "Módulos de Kernel", "CUDA / OpenCL"]
  }
];

// 2. Datos estructurados de Proyectos con métricas reales
const projects = [
  {
    title: "Optimización de Red y Mitigación de Bufferbloat",
    category: "Redes & Infraestructura",
    description: "Despliegue de firmware OpenWrt en un enrutador Cudy AX3000 operando en modo WISP, enfocado en estabilidad de latencia bajo carga y filtrado de red local.",
    metrics: [
      "Control de tráfico SQM con algoritmo CAKE para eliminar picos de latencia",
      "Filtrado de publicidad y rastreadores a nivel de red mediante DNS",
      "Segmentación y ajuste de parámetros inalámbricos en entorno saturado"
    ],
    tags: ["OpenWrt", "SQM / QoS", "DNS Filtering", "Networking"],
    repoLink: "https://github.com/budasker",
    linkText: ">_ Ver perfil en GitHub"
  },
  {
    title: "Entorno Linux & Aceleración por Hardware",
    category: "Sistemas & Kernel",
    description: "Configuración y mantenimiento de estación de trabajo sobre EndeavourOS (Arch Linux), integrando módulos de kernel propietarios y herramientas de diagnóstico.",
    metrics: [
      "Compilación automática de módulos con DKMS para GPU NVIDIA 940MX",
      "Integración funcional de entornos CUDA y OpenCL en Arch Linux",
      "Flasheo y depuración de Custom ROMs (PixelOS / Evolution X) vía ADB/Fastboot"
    ],
    tags: ["EndeavourOS", "DKMS", "CUDA / OpenCL", "Android ROMs"],
    repoLink: "https://github.com/budasker",
    linkText: ">_ Ver perfil en GitHub"
  },
  {
    title: "Herramientas CLI y Algoritmos en C++",
    category: "Desarrollo Bajo Nivel",
    description: "Desarrollo de utilidades en línea de comandos y resolución de problemas algorítmicos en C++, compilados y depurados de forma nativa en Linux.",
    metrics: [
      "Plantillas y entorno de compilación rápida con GCC/G++ y Geany",
      "Ejecución ligera en terminal sin dependencias pesadas",
      "Práctica continua de seguridad y lógica en laboratorios OverTheWire (Bandit)"
    ],
    tags: ["C++", "GCC", "Linux CLI", "Bash"],
    repoLink: "https://github.com/budasker",
    linkText: ">_ Ver perfil en GitHub"
  }
  ];
// 3. Carga automática de todos los Writeups en Markdown dentro de src/pages/notas/
const writeupFiles = import.meta.glob('./notas/*.md', { eager: true });
const writeups = Object.values(writeupFiles).sort(
  (a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);
---

<BaseLayout title="Samuel (Budasker) | Ciberseguridad, Linux y Redes">
  
  <!-- SECCIÓN HERO / PRESENTACIÓN -->
  <section class="hero">
    <div class="status-badge">
      <span class="status-dot"></span> Disponible para proyectos y aprendizaje
    </div>

    <h1 class="hero-title">
      Hola, soy <span class="accent">Samuel</span>_
    </h1>

    <h2 class="hero-subtitle">
      Estudiante de Ciberseguridad & Entusiasta de Linux y Redes
    </h2>

    <p class="hero-bio">
      Desarrollador en formación desde Sucre, Bolivia. Me apasiona la administración de sistemas en Linux, la seguridad en redes y la programación en C++. Siempre busco entender y optimizar cómo funciona la tecnología a bajo nivel.
    </p>

    <div class="hero-actions">
      <a href="https://github.com/budasker" target="_blank" rel="noopener noreferrer" class="btn-outline">
        &gt; GitHub
      </a>
      <a href="mailto:budask3r@gmail.com" class="btn-solid">
        &gt; Contactar
      </a>
    </div>
  </section>

  <!-- SECCIÓN HABILIDADES -->
  <section id="habilidades" class="section">
    <h2 class="section-title">
      <span class="accent">~/</span>Habilidades_y_Stack
    </h2>

    <div class="skills-grid">
      {skillCategories.map((category) => (
        <div class="skill-card">
          <h3>{category.title}</h3>
          <div class="badges">
            {category.skills.map((skill) => (
              <span class="badge">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SECCIÓN PROYECTOS -->
  <section id="proyectos" class="section">
    <h2 class="section-title">
      <span class="accent">~/</span>Proyectos_Destacados
    </h2>

<div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard 
          title={project.title}
          category={project.category}
          description={project.description}
          metrics={project.metrics}
          tags={project.tags}
          repoLink={project.repoLink}
          linkText={project.linkText}
        />
      ))}
    </div>
    
  </section>
<!-- SECCIÓN WRITEUPS / NOTAS TÉCNICAS -->
  <section id="writeups" class="section">
    <h2 class="section-title">
      <span class="accent">~/</span>Notas_y_Writeups
    </h2>

    <div class="writeups-list">
      {writeups.map((post: any) => (
        <a href={post.url} class="writeup-item">
          <div class="writeup-info">
            <div class="writeup-meta">
              <span class="writeup-cat">{post.frontmatter.category}</span>
              <span>•</span>
              <time>{post.frontmatter.date}</time>
            </div>
            <h3>{post.frontmatter.title}</h3>
            <p>{post.frontmatter.description}</p>
          </div>
          <span class="read-more">&gt;_ Leer nota</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* Utilidades generales */
  .accent {
    color: var(--accent);
  }

  .section {
    margin-bottom: 5.5rem;
    scroll-margin-top: 5rem; /* Evita que el navbar fijo tape el título al navegar */
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    margin-bottom: 2rem;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  /* Estilos del Hero */
  .hero {
    margin-top: 5rem;
    margin-bottom: 5.5rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px #22c55e;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    color: var(--text-main);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }

  .hero-bio {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 640px;
    margin-bottom: 2.2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Botones */
  .btn-outline, .btn-solid {
    padding: 0.65rem 1.3rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .btn-outline {
    border: 1px solid var(--border-color);
    color: var(--text-main);
    background-color: transparent;
  }

  .btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .btn-solid {
    background-color: var(--accent);
    color: var(--bg-color);
    font-weight: 600;
    border: 1px solid var(--accent);
  }

  .btn-solid:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Cuadrícula de Habilidades */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .skill-card {
    background-color: rgba(30, 41, 59, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.25rem;
  }

  .skill-card h3 {
    font-size: 1.05rem;
    color: var(--text-main);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    transition: all 0.2s ease;
  }

  .badge:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* Cuadrícula de Proyectos */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
 /* Lista de Writeups */
  .writeups-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .writeup-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
    transition: all 0.2s ease;
  }

  .writeup-item:hover {
    border-color: var(--accent);
    transform: translateX(4px);
  }

  .writeup-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .writeup-cat {
    color: var(--accent);
    text-transform: uppercase;
  }

  .writeup-info h3 {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }

  .writeup-info p {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .read-more {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    white-space: nowrap;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .writeup-item {
      flex-direction: column;
      align-items: flex-start;
    }
  } }
</style>
