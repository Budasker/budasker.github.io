---
import BaseLayout from './BaseLayout.astro';
import { siteConfig } from '@data/siteConfig';

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={`${frontmatter.title} | ${siteConfig.handle}`}
  description={frontmatter.description}
  type="article"
>
  <article class="writeup">
    <div class="writeup-nav">
      <a href={frontmatter.backLink || "/#writeups"} class="back-link">
        {frontmatter.backText || "<- Volver a ~/Writeups"}
      </a>
    </div>

    <header class="writeup-header">
      <div class="writeup-meta">
        <span class="category">{frontmatter.category}</span>
        <span class="separator">•</span>
        <time datetime={frontmatter.date}>{frontmatter.date}</time>
      </div>
      
      <h1 class="writeup-title">{frontmatter.title}</h1>
      
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="tags">
          {frontmatter.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="writeup-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  async function copyToClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fallback si falla la promesa o permisos
      }
    }

    try {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      textarea.style.left = '-9999px';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      const successful = document.execCommand('copy');
      document.body.removeChild(textarea);
      return successful;
    } catch {
      return false;
    }
  }

  function initCopyButtons() {
    const preBlocks = document.querySelectorAll('.writeup-content pre');

    preBlocks.forEach((pre) => {
      // Evitar duplicar el botón si ya fue procesado
      if (pre.parentElement?.classList.contains('code-wrapper')) return;

      // Crear contenedor relativo para que el botón no se mueva al hacer scroll horizontal
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      // Crear el botón de copiado accesible
      const button = document.createElement('button');
      button.className = 'copy-code-btn';
      button.type = 'button';
      button.setAttribute('aria-label', 'Copiar fragmento de código al portapapeles');
      button.textContent = '>_ Copiar';

      button.addEventListener('click', async () => {
        const codeElement = pre.querySelector('code');
        // textContent previene reflow innecesario y respeta tabulaciones/saltos de línea exactos
        const rawContent = (codeElement ? codeElement.textContent : pre.textContent) || '';
        const textToCopy = rawContent.replace(/\n$/, '');

        const success = await copyToClipboard(textToCopy);

        if (success) {
          button.textContent = '✓ Copiado';
          button.classList.add('copied');

          setTimeout(() => {
            button.textContent = '>_ Copiar';
            button.classList.remove('copied');
          }, 2000);
        } else {
          button.textContent = 'Error';
          setTimeout(() => {
            button.textContent = '>_ Copiar';
          }, 2000);
        }
      });

      wrapper.appendChild(button);
    });
  }

  // Inicialización defensiva compatible con carga estándar y ViewTransitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCopyButtons);
  } else {
    initCopyButtons();
  }
  document.addEventListener('astro:page-load', initCopyButtons);
</script>

<style>
  .writeup {
    margin-top: 3.5rem;
    margin-bottom: 5rem;
  }

  .writeup-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .writeup-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .writeup-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .category {
    color: var(--accent);
    text-transform: uppercase;
  }

  .writeup-title {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--text-main);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  /* Estilos para el contenido generado desde Markdown */
  .writeup-content :global(h2) {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    color: var(--text-main);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-left: 3px solid var(--accent);
    padding-left: 0.75rem;
  }

  .writeup-content :global(h3) {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--text-main);
    margin-top: 1.8rem;
    margin-bottom: 0.75rem;
  }

  .writeup-content :global(p) {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }

  .writeup-content :global(ul),
  .writeup-content :global(ol) {
    color: var(--text-muted);
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .writeup-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .writeup-content :global(strong) {
    color: var(--text-main);
  }

  .writeup-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--bg-card);
    color: var(--accent);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  /* Contenedor y bloques de código */
  .writeup-content :global(.code-wrapper) {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .writeup-content :global(pre) {
    background-color: var(--bg-code, #070a12) !important;
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    padding-right: 6.5rem; /* Espacio libre a la derecha para que el botón nunca tape el texto */
    border-radius: 8px;
    overflow-x: auto;
    margin: 0;
  }

  .writeup-content :global(pre code) {
    background-color: transparent;
    color: var(--text-main);
    padding: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Botón interactivo de copiar */
  .writeup-content :global(.copy-code-btn) {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    background-color: rgba(17, 24, 39, 0.85);
    backdrop-filter: blur(4px);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.65rem;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
  }

  .writeup-content :global(.copy-code-btn:hover) {
    color: var(--accent);
    border-color: var(--accent);
    background-color: var(--bg-card);
  }

  .writeup-content :global(.copy-code-btn.copied) {
    color: #22c55e;
    border-color: #22c55e;
    background-color: rgba(34, 197, 94, 0.1);
  }
</style>
