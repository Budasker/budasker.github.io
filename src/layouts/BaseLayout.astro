---
// Importamos los estilos globales que acabas de crear
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Permite recibir un título dinámico desde cada página (por defecto usa "Budasker")
const { title = "Budasker | Portafolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Fuentes de Google: Inter (texto normal) y JetBrains Mono (código) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Aquí agregaremos luego el componente Navbar -->
    <Navbar/>
    
    <main class="container">
      <!-- El slot es mágico: aquí se inyectará el contenido de la página que estemos viendo -->
      <slot /> 
    </main>

    <!-- Aquí agregaremos luego el componente Footer -->
    <Footer />
  </body>
</html>
